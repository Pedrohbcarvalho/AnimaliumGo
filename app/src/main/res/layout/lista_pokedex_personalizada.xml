<?xml version="1.0" encoding="utf-8"?>
<!-- Linha do Diário: foto do animal (URL), nome popular e nome científico -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <ImageView
        android:id="@+id/imagemPokemonPokedex"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:scaleType="centerInside"
        android:layout_margin="10dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="normal"
        android:textSize="20dp"
        android:textColor="#000000"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="12dp"
        android:id="@+id/txtNomePokemonPokedex"
        android:layout_toRightOf="@+id/imagemPokemonPokedex" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="italic"
        android:textSize="14dp"
        android:textColor="#808080"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="20dp"
        android:id="@+id/txtNumeroPokemonPokedex"
        android:layout_below="@+id/txtNomePokemonPokedex"
        android:layout_toRightOf="@+id/imagemPokemonPokedex" />

</RelativeLayout>
