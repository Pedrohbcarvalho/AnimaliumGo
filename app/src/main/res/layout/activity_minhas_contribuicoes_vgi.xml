<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:onClick="clickVoltar"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif"
            android:text="Minhas Contribuições"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Área fixa: painel, busca e filtros -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_eco" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="Painel de Registros"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Contadores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <include android:id="@+id/contadorTotal" layout="@layout/item_contador_vgi" />
            <Space android:layout_width="8dp" android:layout_height="0dp" />
            <include android:id="@+id/contadorAprovados" layout="@layout/item_contador_vgi" />
            <Space android:layout_width="8dp" android:layout_height="0dp" />
            <include android:id="@+id/contadorPendentes" layout="@layout/item_contador_vgi" />
            <Space android:layout_width="8dp" android:layout_height="0dp" />
            <include android:id="@+id/contadorRejeitados" layout="@layout/item_contador_vgi" />
        </LinearLayout>

        <!-- Busca -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/edtBusca"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fundo_pilula"
                android:elevation="1dp"
                android:hint="Pesquisar por espécie ou ID..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/on_surface_variant"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="12dp"
                android:elevation="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                android:tint="@color/on_surface_variant" />

            <ImageButton
                android:id="@+id/btnLimparBusca"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Limpar busca"
                android:elevation="1dp"
                android:onClick="clickLimparBusca"
                android:src="@drawable/ic_close"
                android:tint="@color/on_surface_variant"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Filtros por status -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/filtroTodos" style="@style/PilulaFiltroVgi" />
                <TextView android:id="@+id/filtroAprovados" style="@style/PilulaFiltroVgi" />
                <TextView android:id="@+id/filtroPendentes" style="@style/PilulaFiltroVgi" />
                <TextView android:id="@+id/filtroRejeitados" style="@style/PilulaFiltroVgi" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Lista e estados -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listaContribuicoes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingTop="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtNenhumResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Nenhum registro encontrado."
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressCarregando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <LinearLayout
            android:id="@+id/areaMensagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtMensagem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnTentarNovamente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/fundo_pilula"
                android:backgroundTint="@color/primary"
                android:onClick="clickTentarNovamente"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Tentar novamente"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
