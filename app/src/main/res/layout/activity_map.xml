<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="teste.lucasvegi.pokemongooffline.Controller.MapActivity">

    <fragment
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:id="@+id/mapa" />


    <RelativeLayout
        android:layout_height="match_parent"
        android:layout_width="match_parent">

        <RelativeLayout
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:background="@android:color/white"
            android:alpha="1.0"
            android:clickable="false">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:layout_centerInParent="true"
                android:background="@android:color/transparent"
                android:alpha="1.0"
                android:clickable="false">

                <LinearLayout
                    android:id="@+id/linhaBotoes"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/botaoPerfil"
                        android:layout_width="0dp"
                        android:layout_height="61dp"
                        android:layout_weight="1"
                        android:layout_marginTop="2dp"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/male_profile"
                        android:onClick="clickPerfil" />

                    <ImageButton
                        android:id="@+id/botaoMapaGeral"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginTop="2dp"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/mapa_captura_grande"
                        android:onClick="clickMapaCaptura" />

                    <ImageButton
                        android:id="@+id/botaoOvo"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginTop="2dp"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ovo_verde"
                        android:onClick="clickOvo" />

                    <ImageButton
                        android:id="@+id/botaoPokedex"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginTop="2dp"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/diario"
                        android:onClick="clickPokedex" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtNomeUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/linhaBotoes"
                    android:layout_marginLeft="10dp"
                    android:text="lucasvegi"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@android:color/black" />
            </RelativeLayout>

        </RelativeLayout>

        <WebView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/imgLoader"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_margin="15dp" />

    </RelativeLayout>
</FrameLayout>